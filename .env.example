# Copy this file to .env and fill in the values. .env is gitignored.

# Supabase: Project Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Account → Access Tokens (lets Claude create tables and storage)
SUPABASE_ACCESS_TOKEN=

# Vercel: Account Settings → Tokens (lets Claude deploy)
VERCEL_TOKEN=

# Resend: API Keys (sign-in emails without Supabase's tight free limits)
RESEND_API_KEY=
