# Copy this file to .env and fill in the values. .env is gitignored.

# Supabase → Project Settings → API Keys
PUBLIC_SUPABASE_URL=https://fqvvzxhhocpyvaaaullo.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# supabase.com/dashboard/account/tokens → Generate new token
# (lets Claude create the tables, storage and auth settings)
SUPABASE_ACCESS_TOKEN=

# Vercel → Account Settings → Tokens (lets Claude deploy)
VERCEL_TOKEN=

# Resend → API Keys (sign-in emails without Supabase's tight free limits)
RESEND_API_KEY=

# Google OAuth client (Google Cloud → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Ask this map": any OpenAI-compatible API. Default is Groq's free tier
# (console.groq.com → API Keys). Ask is hidden when this is empty.
AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# AI_FALLBACK_MODEL=openai/gpt-oss-20b
